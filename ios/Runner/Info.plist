<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key><string>AURA</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>aura_music</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key><string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UIBackgroundModes</key>
    <array><string>audio</string><string>fetch</string></array>
    <key>NSAppleMusicUsageDescription</key>
    <string>AURA потребує доступу до вашої музичної бібліотеки</string>
    <key>NSCameraUsageDescription</key>
    <string>AURA використовує камеру для розпізнавання жестів (✊ пауза / 🖐 відтворення)</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>AURA потребує доступу до галереї для встановлення фону</string>
    <key>CADisableMinimumFrameDurationOnPhone</key><true/>
    <key>UIApplicationSupportsIndirectInputEvents</key><true/>
    <key>LSRequiresIPhoneOS</key><true/>
</dict>
</plist>
